# Skopiuj do .env i uzupełnij. .env jest w .gitignore.
# Bez cudzysłowów wokół wartości: Spring czyta ten plik jako .properties.

# --- Postgres (compose + Spring) ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=

# --- Telegram (0.8) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# --- Java -> Python (0.11) ---
AI_SERVICE_URL=

# --- LLM (0.10, provider do decyzji w 1.7) ---
LLM_API_KEY=
